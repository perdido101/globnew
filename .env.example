# Postgres (docker-compose maps the container to port 5433)
DATABASE_URL=postgres://globalwire:globalwire@localhost:5433/globalwire

# Optional — enables LLM location fallback, categorisation and importance hints.
# Without it the pipeline runs on the offline gazetteer + keyword heuristics.
ANTHROPIC_API_KEY=

# Optional — Reddit "script"/"web" app credentials (https://www.reddit.com/prefs/apps).
# Without them Reddit falls back to public rising RSS (no upvote-velocity ranking).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for a descriptive UA: <platform>:<app id>:<version> (by /u/<your username>)
REDDIT_USER_AGENT=web:global-wire:0.1 (by /u/your_username)

# Secret used to sign image-proxy URLs. Set to any long random string in production.
IMAGE_PROXY_SECRET=change-me-to-a-long-random-string

# Optional — protects /admin/* (pass ?token=… or the x-admin-token header).
ADMIN_TOKEN=

# Server port (the web dev server proxies /api, /stream, /img, /admin to it)
PORT=8787
LOG_LEVEL=info
